<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 10 folgt die App (und damit die Seite) dem hellen oder dunklen Systemdesign. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
